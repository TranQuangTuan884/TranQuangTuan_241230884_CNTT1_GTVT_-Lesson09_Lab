@model IEnumerable<Lesson09_Lab.Areas.Admin.Models.Category>
@{ ViewData["Title"] = "Quản lý Danh mục"; Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; }
<section class="content-header"><div class="container-fluid d-flex justify-content-between align-items-center"><h1>Quản lý Danh mục</h1><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm Danh mục</a></div></section><section class="content"><div class="container-fluid">@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>} @if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}<div class="card"><div class="card-body table-responsive"><table class="table table-bordered table-striped align-middle"><thead><tr><th>Mã</th><th>Tên danh mục</th><th>Trạng thái</th><th>Ngày tạo</th><th>Đường dẫn ảnh</th><th>Mô tả</th><th>Thao tác</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Id</td><td>@item.Name</td><td>@item.Status</td><td>@item.CreatedDate.ToString("dd/MM/yyyy")</td><td>@item.Image</td><td>@item.Description</td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i> Sửa</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Xóa</a></td></tr>}</tbody></table>@if(!Model.Any()){<div class="text-center text-muted py-4">Chưa có dữ liệu. Hãy nhấn “Thêm Danh mục”.</div>}</div></div></div></section>