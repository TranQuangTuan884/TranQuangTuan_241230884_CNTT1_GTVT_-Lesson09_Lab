@{ ViewData["Title"]="Dashboard"; Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; }
<section class="content-header"><div class="container-fluid"><h1>Dashboard</h1><p class="text-muted">Tổng quan hệ thống quản trị nội dung</p></div></section><section class="content"><div class="container-fluid"><div class="row">
@foreach(var box in new[]{("Danh mục",(int)ViewBag.CategoryCount,"/Admin/Categories","bi-tags","info"),("Sản phẩm",(int)ViewBag.ProductCount,"/Admin/Products","bi-box-seam","success"),("Banner",(int)ViewBag.BannerCount,"/Admin/Banners","bi-image","warning"),("Bài viết",(int)ViewBag.BlogCount,"/Admin/Blogs","bi-pencil-square","danger")}) { <div class="col-lg-3 col-6"><div class="small-box text-bg-@box.Item5"><div class="inner"><h3>@box.Item2</h3><p>@box.Item1</p></div><i class="small-box-icon bi @box.Item4"></i><a href="@box.Item3" class="small-box-footer link-light link-underline-opacity-0">Quản lý <i class="bi bi-arrow-right-circle"></i></a></div></div> }</div><div class="card"><div class="card-header"><h3 class="card-title">Bắt đầu nhanh</h3></div><div class="card-body"><p>Chọn một chức năng để quản lý dữ liệu. Dữ liệu được lưu trong cơ sở dữ liệu SQLite tại <code>admin.db</code>.</p><a class="btn btn-outline-primary me-2" href="/Admin/Categories/Create">Thêm danh mục</a><a class="btn btn-outline-success me-2" href="/Admin/Products/Create">Thêm sản phẩm</a><a class="btn btn-outline-info me-2" href="/Admin/Banners/Create">Thêm banner</a><a class="btn btn-outline-warning" href="/Admin/Blogs/Create">Thêm bài viết</a></div></div></div></section>